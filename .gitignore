# Build output
/bin/
*.exe
*.exe~
*.test
*.out
dist/
internal/webui/embedded/

# Local configuration and secrets — never committed
.env

# Editors / tooling
.idea/
.vscode/
.claude/
node_modules/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local runtime state of a dev node (journal files, keys, blobs, logs)
/kalita-data/
/kalita-files/
/tmp-vault/
/.native/
*.log
*.pid

# Scratch: temporary files, research downloads, agent notes — keep them outside the repo
/tmp/
/agent/

# Strategy / commercial documents never belong in this public repository
/docs/MASTERPLAN.md
/docs/products/

# KnowVault eval run artifacts (reproducible from the harness)
workers/knowvault_eval/eval_results_*.json
