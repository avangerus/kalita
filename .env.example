# Copy to .env and adjust. docker compose reads .env automatically.

# Postgres password (the journal database). CHANGE THIS before any real use.
POSTGRES_PASSWORD=change-me

# Which module the node runs. Any directory under /opt/kalita/packs or
# /opt/kalita/examples inside the image, or a path you bind-mount.
# Default: the self-building product (Ask Kalita + design sessions).
KALITA_PACK=/opt/kalita/packs/builder

# The role whose human signature applies definition changes (Ask Kalita's
# proposals). Default "Owner".
KALITA_APPROVER=Owner

# Ask Kalita worker URL advertised to the web UI. For a localhost pilot leave
# empty (the UI derives http://<host>:8400 — the builder port). For a remote
# deployment, set the address your users can reach (put a TLS proxy in front
# of the builder container's port 8400).
KALITA_BUILDER_URL=

# Optional reasoning model for Ask Kalita (OpenAI-compatible /chat/completions).
# Empty = deterministic expert mode (no external model).
KALITA_LLM_URL=

# Version the image reports (`kalita version`). Unset = dev build 0.1.0-dev;
# for a release set it to the git tag, e.g. KALITA_VERSION=v1.0.0-rc.2
# KALITA_VERSION=

# Host port to publish the HTTPS node on.
KALITA_PORT=8443

# TLS mode: "self-signed" = the node makes its own cert on first boot and serves
# HTTPS itself. Empty = no TLS (then the node needs --insecure-http and a proxy).
KALITA_TLS=self-signed
KALITA_TLS_CN=localhost

# Outbound webhook allowlist (Cycle-B1 / D-011): comma-separated hosts the
# node's own webhook runner may deliver to. Empty = NO outbound webhooks
# (fail-closed). The node journals every delivered call for `kalita egress-report`.
# Hosts are matched exactly; IDN domains go in their punycode (xn--) form.
KALITA_EGRESS_DOMAINS=
# An allowlisted NAME may resolve only to public or loopback addresses; set 1 to
# let it reach private networks (LAN systems such as an on-prem ERP). An IP
# address listed in KALITA_EGRESS_DOMAINS is always reachable as listed.
# KALITA_EGRESS_ALLOW_PRIVATE=1

# Database DSN (Postgres) and secrets file. Required for a persisted journal.
# KALITA_PG_DSN=postgres://postgres:change-me@postgres:5432/kalita
# KALITA_SECRETS_FILE=/run/secrets/kalita
