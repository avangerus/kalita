# Copy to .env and adjust. docker compose reads .env automatically.

# Postgres password (the journal database). CHANGE THIS before any real use.
POSTGRES_PASSWORD=change-me

# Which module the node runs. Any directory under /opt/kalita/packs or
# /opt/kalita/examples inside the image, or a path you bind-mount.
KALITA_PACK=/opt/kalita/packs/contracts

# Host port to publish the HTTPS node on.
KALITA_PORT=8443

# TLS mode: "self-signed" = the node makes its own cert on first boot and serves
# HTTPS itself. Empty = no TLS (then the node needs --insecure-http and a proxy).
KALITA_TLS=self-signed
KALITA_TLS_CN=localhost

# Outbound webhook allowlist (Cycle-B1 / D-011): comma-separated hosts the
# node's own webhook runner may deliver to. Empty = NO outbound webhooks
# (fail-closed). The node journals every delivered call for `kalita egress-report`.
KALITA_EGRESS_DOMAINS=

# Database DSN (Postgres) and secrets file. Required for a persisted journal.
# KALITA_PG_DSN=postgres://postgres:change-me@postgres:5432/kalita
# KALITA_SECRETS_FILE=/run/secrets/kalita
